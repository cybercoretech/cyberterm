#!/usr/bin/env bash
# Quality gate for cyberterm.
#
# Scaled down from the multi-crate workspace version of this script (see
# diagprint, https://github.com/cybercoretech/diagprint) since cyberterm is a
# single bin crate, not a workspace: no per-package `packages`/`root_features`
# arrays, no publish mode (a terminal emulator binary isn't published to
# crates.io), and no pinned-MSRV re-run (that matters for a library other
# people compile against with their own toolchain constraints; a bin only
# needs to build with whatever toolchain built it).
#
# Modes:
#   quick  - fmt/whitespace/check/clippy (fast, run constantly)
#   full   - quick + tests + strict rustdoc

set -euo pipefail

require_repo_root() {
    if [[ ! -f Cargo.toml ]]; then
        echo "error: run this from the cyberterm project root (no Cargo.toml here)" >&2
        exit 1
    fi
}

run_gate() {
    local name="$1"
    shift
    echo "==> ${name}"
    if ! "$@"; then
        echo "FAILED: ${name}" >&2
        exit 1
    fi
}

require_repo_root
mode="${1:-quick}"

case "$mode" in
    quick)
        run_gate "git diff --check" git diff --check
        run_gate "cargo fmt --check" cargo fmt --all -- --check
        run_gate "cargo check" cargo check --all-targets --all-features
        run_gate "cargo clippy" cargo clippy --all-targets --all-features -- -D warnings
        ;;
    full)
        "$0" quick
        run_gate "cargo test" cargo test --bin cyberterm --all-features
        # No `--doc` step: this is a bin-only crate (no library target), so
        # there are no doctests to run -- `cargo test --doc` always errors
        # here with "no library targets found," not a real failure.
        run_gate "cargo doc (strict)" env RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features --bin cyberterm
        ;;
    *)
        echo "usage: $0 [quick|full]" >&2
        exit 1
        ;;
esac

echo "All gates passed (${mode})."
